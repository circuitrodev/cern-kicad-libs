	)
	(embedded_fonts no)
	(model "${CERN_3DMODEL_DIR}/HIROSE_FX11LB-120S-12-SV.stp"
		(offset
			(xyz 0 -0 0)
		)
		(scale
			(xyz 1 1 1)
		)
		(rotate
			(xyz -0 -0 0)
		)
	)
)
