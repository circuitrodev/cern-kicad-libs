	(model "${CERN_3DMODEL_DIR}/PCBM_NUMATO_RL80001.stp"
		(offset
			(xyz 0 -0 0)
		)
		(scale
			(xyz 1 1 1)
		)
		(rotate
			(xyz -0 -0 0)
		)
	)
)
